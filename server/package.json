{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:baseline:mark": "prisma migrate resolve --applied 20260831000000_postgres_baseline",
    "push:vapid": "web-push generate-vapid-keys",
    "seed": "tsx prisma/seed.ts",
    "test": "tsx src/tests/smoke.ts",
    "test:all": "tsx src/tests/run-all.ts",
    "test:suites": "tsx src/tests/run-all.ts --suites",
    "test:flows": "tsx src/tests/run-all.ts --flows",
    "test:live": "tsx src/tests/live/test-live-api.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.0.1",
    "@prisma/client": "^6.2.1",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.2.0",
    "pino": "^10.3.1",
    "prisma": "^6.2.1",
    "qrcode": "^1.5.4",
    "tsx": "^4.19.2",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.2"
  }
}
