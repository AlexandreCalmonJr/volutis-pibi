# Desenvolvimento/produção (PostgreSQL)
# Exemplo local: serviço `postgres` do docker-compose
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/volutis?schema=public"

# Obrigatório em produção: segredo forte e único
# Gere com: openssl rand -hex 32
JWT_SECRET="troque-por-um-segredo-forte"

PORT=3333

# URL pública do frontend (usada nos links de confirmação do WhatsApp)
APP_URL="http://localhost:5173"

# Push notifications web/PWA (VAPID)
VAPID_SUBJECT="mailto:admin@pibi.org.br"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# CORS: origens permitidas separadas por vírgula (default: todas em dev)
# CORS_ORIGINS="https://volutis-pibi.vercel.app"

# WhatsApp (WAHA)
WHATSAPP_API_URL="http://localhost:3000"
WHATSAPP_SESSION="default"
# WHATSAPP_API_KEY="sua_chave_secreta"
