// Volutis PIBI — Prisma Schema
// Dev: SQLite | Prod: PostgreSQL (trocar provider + DATABASE_URL)
// Nota: enums e listas são String (JSON) para portabilidade SQLite;
// a validação de valores é feita via Zod nas rotas.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Church {
  id   String @id @default(cuid())
  name String
  slug String @unique

  // Configuração Holyrics
  holyricsMode      String? // "local" | "online"
  holyricsLocalIp   String?
  holyricsLocalPort Int?    @default(8091)
  holyricsToken     String?
  holyricsApiKey    String?

  // Configuração YouTube Live
  youtubeChannelId    String?
  youtubeApiKey       String?
  youtubeAutoSchedule Boolean @default(false)

  members      Member[]
  ministries   Ministry[]
  events       Event[]
  songs        Song[]
  invites      Invite[]
  applications Application[]
  pendingTokens PendingToken[]
  transferRequests MinistryTransferRequest[]
  feedPosts    FeedPost[]
  feedComments FeedComment[]
  holyricsLogs HolyricsLog[]
  auditLogs    AuditLog[]
  createdAt    DateTime   @default(now())
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  phone           String?
  passwordHash    String
  role            String        @default("MEMBER") // ADMIN | MINISTRY_LEADER | VOLUNTEER | MEMBER
  firstLogin      Boolean       @default(true)
  lastPasswordReset DateTime?
  member          Member?
  refreshTokens   RefreshToken[]
  createdAt       DateTime      @default(now())
}

model Invite {
  id            String    @id @default(cuid())
  code          String    @unique
  role          String    @default("VOLUNTEER") // papel concedido ao usar
  createdByName String?
  expiresAt     DateTime
  usedAt        DateTime?
  usedByEmail   String?
  createdAt     DateTime  @default(now())

  church   Church  @relation(fields: [churchId], references: [id], onDelete: Cascade)
  churchId String

  ministry   Ministry? @relation(fields: [ministryId], references: [id], onDelete: SetNull)
  ministryId String?
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Member {
  id             String    @id @default(cuid())
  name           String
  phone          String? // formato E.164 p/ links wa.me (ex: 5571999999999)
  photoUrl       String?
  avatarKey      String?   @default("violet")
  instruments    String    @default("[]") // JSON array
  birthDate      DateTime?
  approvalStatus String    @default("ACTIVE") // PENDING | ACTIVE | INACTIVE
  approvedAt     DateTime?
  approvedBy     String?

  user   User?   @relation(fields: [userId], references: [id])
  userId String? @unique

  church   Church @relation(fields: [churchId], references: [id])
  churchId String

  ministryMembers  MinistryMember[]
  scheduleItems    ScheduleItem[]
  unavailabilities Unavailability[]
  checkins         CheckIn[]
  badges           Badge[]
  swapRequests     SwapRequest[]
  applications     Application[]
  notifications    UserNotification[]
  pushSubscriptions PushSubscription[]
  transferRequests MinistryTransferRequest[] @relation("TransferMember")
  feedPosts        FeedPost[]
  feedComments     FeedComment[]
  points           Int              @default(0)

  @@index([churchId])
  @@index([approvalStatus])
}

model Ministry {
  id    String  @id @default(cuid())
  name  String
  icon  String?
  color String?

  church   Church @relation(fields: [churchId], references: [id])
  churchId String

  roles                  MinistryRole[]
  members                MinistryMember[]
  applicationPreferences ApplicationPreference[]
  invites                Invite[]
  outgoingTransfers      MinistryTransferRequest[] @relation("TransferFromMinistry")
  incomingTransfers      MinistryTransferRequest[] @relation("TransferToMinistry")
  deletedAt              DateTime?

  @@index([churchId])
  @@index([deletedAt])
}

model MinistryRole {
  id         String   @id @default(cuid())
  name       String
  ministry   Ministry @relation(fields: [ministryId], references: [id], onDelete: Cascade)
  ministryId String
}

model MinistryMember {
  id         String   @id @default(cuid())
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId   String
  ministry   Ministry @relation(fields: [ministryId], references: [id], onDelete: Cascade)
  ministryId String
  isLeader   Boolean  @default(false)
  roles      String   @default("[]") // JSON array de funções

  @@unique([memberId, ministryId])
}

model Event {
  id          String    @id @default(cuid())
  title       String
  type        String // SUNDAY_MORNING | SUNDAY_EVENING | WEDNESDAY_PRAYER | REHEARSAL | SPECIAL_EVENT
  date        DateTime
  startTime   DateTime
  endTime     DateTime?
  isRecurrent Boolean   @default(false)
  recurrence  String? // "weekly:sunday" etc.

  bannerUrl           String? // Imagem/Capa do culto (visível nos cards)
  theme               String? // Tema do culto/sermão
  preacher            String? // Nome do pregador
  youtubeLiveId       String?
  youtubeBroadcastUrl String?
  youtubeStreamKey    String?
  youtubeStatus       String?   @default("NOT_SCHEDULED") // NOT_SCHEDULED | SCHEDULED | LIVE | COMPLETED
  youtubeScheduledAt  DateTime?

  church   Church @relation(fields: [churchId], references: [id])
  churchId String

  scheduleItems ScheduleItem[]
  liturgyItems  LiturgyItem[]
  setlistItems  SetlistItem[]
  chatMessages  ChatMessage[]
  mediaAssets   EventMediaAsset[]
  deletedAt     DateTime?

  @@index([churchId, date])
  @@index([startTime])
  @@index([deletedAt])
}

model EventMediaAsset {
  id         String   @id @default(cuid())
  type       String   // YOUTUBE_THUMBNAIL | DATASHOW_WALLPAPER | SERMON_SLIDE | BIBLE_BACKGROUND | OTHER
  title      String   // ex: "Capa do YouTube 1920x1080", "Papel de Parede Datashow"
  fileUrl    String   // Link ou data URL da imagem/arquivo
  fileName   String?
  fileSize   Int?     // Tamanho em bytes
  mimeType   String?  // image/png, image/jpeg, etc.
  uploadedBy String?  // Nome de quem enviou
  createdAt  DateTime @default(now())

  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId    String

  @@index([eventId])
}

model ScheduleItem {
  id            String  @id @default(cuid())
  status        String  @default("PENDING") // PENDING | CONFIRMED | DECLINED | SWAP_REQUESTED
  refusalReason String?
  roleName      String
  reminderSentAt DateTime?

  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId  String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId String

  checkin      CheckIn?
  swapRequests SwapRequest[]

  @@unique([eventId, memberId, roleName])
  @@index([memberId])
  @@index([eventId])
  @@index([status])
  @@index([memberId, status])
  @@index([eventId, status])
  @@index([reminderSentAt])
}

model SwapRequest {
  id     String @id @default(cuid())
  status String @default("PENDING") // PENDING | ACCEPTED | DECLINED | CANCELLED

  scheduleItem   ScheduleItem @relation(fields: [scheduleItemId], references: [id], onDelete: Cascade)
  scheduleItemId String
  targetMember   Member?      @relation(fields: [targetMemberId], references: [id], onDelete: SetNull)
  targetMemberId String?
  message        String?
  createdAt      DateTime @default(now())
  respondedAt    DateTime?

  @@index([targetMemberId])
}

model Unavailability {
  id        String   @id @default(cuid())
  date      DateTime
  reason    String?
  recurring Boolean  @default(false)

  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId String
}

model CheckIn {
  id          String   @id @default(cuid())
  checkedInAt DateTime @default(now())
  method      String // "qrcode" | "manual"

  member         Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId       String
  scheduleItem   ScheduleItem @relation(fields: [scheduleItemId], references: [id], onDelete: Cascade)
  scheduleItemId String       @unique
}

model Song {
  id           String  @id @default(cuid())
  title        String
  artist       String?
  originalKey  String?
  bpm          Int?
  structure    String?
  youtubeUrl   String?
  spotifyUrl   String?
  cifraClubUrl String?
  lyrics       String?
  chords       String?
  holyricsId   String?
  holyricsSyncStatus String? // LINKED | SYNCED | ERROR | PENDING
  holyricsSyncError  String?
  holyricsLastSyncAt DateTime?

  church   Church @relation(fields: [churchId], references: [id])
  churchId String

  setlistItems SetlistItem[]
}

model SetlistItem {
  id      String  @id @default(cuid())
  order   Int
  songKey String?
  notes   String?

  song    Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  songId  String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String
}

model LiturgyItem {
  id          String  @id @default(cuid())
  order       Int
  title       String
  startTime   String?
  durationMin Int?
  responsible String?
  bibleRef    String?
  notes       String?

  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String
}

model ChatMessage {
  id         String   @id @default(cuid())
  content    String
  authorName String
  createdAt  DateTime @default(now())

  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String

  @@index([eventId, createdAt])
}

model FeedPost {
  id         String   @id @default(cuid())
  content    String?
  mediaType  String? // IMAGE | AUDIO | LINK
  mediaUrl   String?
  linkUrl    String?
  authorName String
  createdAt  DateTime @default(now())

  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  churchId String

  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId String

  comments FeedComment[]

  @@index([churchId, createdAt])
  @@index([memberId, createdAt])
}

model FeedComment {
  id         String   @id @default(cuid())
  content    String
  authorName String
  createdAt  DateTime @default(now())

  post   FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String

  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  churchId String

  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId String

  @@index([postId, createdAt])
  @@index([memberId, createdAt])
}

model Badge {
  id   String @id @default(cuid())
  name String
  icon String

  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId String
  earnedAt DateTime @default(now())

  @@index([memberId])
}

// ─── Captação & Cadastro ───────────────────────────────────────────

model Application {
  id           String   @id @default(cuid())
  name         String
  email        String?
  phone        String?
  photoUrl     String?
  avatarKey    String?  @default("violet")
  instruments  String   @default("[]") // JSON array
  availability String?  // JSON: { "monday": ["morning"], ... }
  notes        String?  // notas internas do líder
  status       String   @default("PENDING") // PENDING | APPROVED | REJECTED
  source       String   @default("PUBLIC") // PUBLIC | ADMIN | EXISTING
  appliedAt    DateTime @default(now())
  reviewedAt   DateTime?
  reviewedBy   String?  // memberId do líder que revisou

  church   Church @relation(fields: [churchId], references: [id])
  churchId String

  member   Member? @relation(fields: [memberId], references: [id])
  memberId String?

  preferences ApplicationPreference[]

  @@index([churchId])
  @@index([status])
  @@index([memberId])
}

model ApplicationPreference {
  id            String @id @default(cuid())
  applicationId String
  ministryId    String

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  ministry    Ministry    @relation(fields: [ministryId], references: [id], onDelete: Cascade)

  @@unique([applicationId, ministryId])
}

model PendingToken {
  id        String   @id @default(cuid())
  email     String
  phone     String?
  name      String
  token     String   @unique
  role      String   @default("VOLUNTEER")
  churchId  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([churchId])
}

model UserNotification {
  id           String   @id @default(cuid())
  type         String
  title        String
  body         String
  data         String?
  whatsappLink String?
  readAt       DateTime?
  createdAt    DateTime @default(now())

  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId String

  @@index([memberId, createdAt])
  @@index([memberId, readAt])
  @@index([memberId, readAt, createdAt])
}

model PushSubscription {
  id             String   @id @default(cuid())
  endpoint       String   @unique
  p256dh         String
  auth           String
  userAgent      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lastNotifiedAt DateTime?

  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId String

  @@index([memberId])
}

model MinistryTransferRequest {
  id                     String   @id @default(cuid())
  status                 String   @default("PENDING_SOURCE_LEADER") // PENDING_SOURCE_LEADER | PENDING_TARGET_LEADER | APPROVED | REJECTED | CANCELLED
  mode                   String   @default("TRANSFER") // TRANSFER | ADD
  requestedRoles         String   @default("[]")
  requestedLeader        Boolean  @default(false)
  reason                 String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  sourceLeaderApprovedAt DateTime?
  sourceLeaderApprovedBy String?
  targetLeaderApprovedAt DateTime?
  targetLeaderApprovedBy String?
  rejectedAt             DateTime?
  rejectedBy             String?
  rejectionReason        String?

  member   Member @relation("TransferMember", fields: [memberId], references: [id], onDelete: Cascade)
  memberId String

  fromMinistry   Ministry? @relation("TransferFromMinistry", fields: [fromMinistryId], references: [id], onDelete: SetNull)
  fromMinistryId String?

  toMinistry   Ministry @relation("TransferToMinistry", fields: [toMinistryId], references: [id], onDelete: Cascade)
  toMinistryId String

  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  churchId String

  @@index([churchId, status])
  @@index([memberId, createdAt])
  @@index([fromMinistryId])
  @@index([toMinistryId])
}

model HolyricsLog {
  id        String   @id @default(cuid())
  action    String
  status    String // SUCCESS | ERROR
  message   String?
  payload   String?
  eventId   String?
  songId    String?
  createdAt DateTime @default(now())

  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  churchId String

  @@index([churchId, createdAt])
  @@index([eventId, createdAt])
  @@index([songId, createdAt])
}

model SchedulerLease {
  key       String   @id
  ownerId   String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  category  String   // SCHEDULE | MEMBER | EVENT | SONG | SECURITY | ADMIN
  details   String?
  actorId   String?
  actorName String
  actorRole String?
  ipAddress String?
  createdAt DateTime @default(now())

  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)
  churchId String

  @@index([churchId, createdAt])
  @@index([category])
}
